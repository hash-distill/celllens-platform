# Copy to /etc/celllens/celllens.env with owner-only permissions.
CELLLENS_PROJECT_ROOT=/srv/celllens
CELLLENS_DATABASE_URL=sqlite:////srv/celllens/data/runtime/celllens.db
CELLLENS_CREATE_DATABASE_SCHEMA=false
CELLLENS_DEPLOYMENT_MODE=private
# Set a random secret locally. Empty token deliberately denies private API access.
CELLLENS_WORKSPACE_TOKEN=
CELLLENS_SESSION_SECURE_COOKIE=true
CELLLENS_WORKER_MODE=external
CELLLENS_WORKER_ENABLED=false
CELLLENS_GPU_AVAILABLE=false
CELLLENS_JOB_LEASE_SECONDS=120
CELLLENS_WORKER_HEARTBEAT_SECONDS=10
CELLLENS_WORKER_STALE_SECONDS=45
CELLLENS_CONTROLLED_IMPORT_ENABLED=false
