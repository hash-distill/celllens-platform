[Unit]
Description=CellLens durable CPU worker
After=network-online.target celllens-migrate.service
Wants=network-online.target
Requires=celllens-migrate.service

[Service]
User=celllens
Group=celllens
WorkingDirectory=/srv/celllens
EnvironmentFile=/etc/celllens/celllens.env
Environment=CELLLENS_DEPLOYMENT_MODE=private
Environment=CELLLENS_WORKER_MODE=external
Environment=PYTHONUNBUFFERED=1
Environment=MPLCONFIGDIR=/srv/celllens/data/runtime/matplotlib
Environment=NUMBA_CACHE_DIR=/srv/celllens/data/runtime/numba
ExecStart=/srv/celllens/.venv/bin/python -m backend.app.worker --kind cpu
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/celllens/data

[Install]
WantedBy=multi-user.target
