  "components": {
    "schemas": {
      "ContextItem": {
        "properties": {
          "cell_line": {
            "type": "string",
            "title": "Cell Line"
          },
          "online_ready": {
            "type": "boolean",
            "title": "Online Ready"
          },
          "validation_ready": {
            "type": "boolean",
            "title": "Validation Ready"
          },
          "precomputed_ready": {
            "type": "boolean",
            "title": "Precomputed Ready"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "disabled_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disabled Reason"
          },
          "readiness_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Readiness Reasons"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cell_line",
          "online_ready",
          "validation_ready",
          "precomputed_ready",
          "model_id"
        ],
        "title": "ContextItem"
      },
      "CoverageSummary": {
        "properties": {
          "state_gene_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "State Gene Fraction"
          },
          "metabolic_gene_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Metabolic Gene Fraction"
          },
          "reaction_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Reaction Fraction"
          },
          "supported_tasks": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Supported Tasks"
          },
          "exploratory_tasks": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Exploratory Tasks"
          },
          "insufficient_tasks": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Insufficient Tasks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state_gene_fraction",
          "metabolic_gene_fraction",
          "reaction_fraction",
          "supported_tasks",
          "exploratory_tasks",
          "insufficient_tasks"
        ],
        "title": "CoverageSummary"
      },
      "CreateRunRequest": {
        "properties": {
          "cell_line": {
            "type": "string",
            "enum": [
              "K562",
              "RPE1",
              "Jurkat",
              "HepG2"
            ],
            "title": "Cell Line"
          },
          "perturbation": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Perturbation"
          },
          "mode": {
            "type": "string",
            "enum": [
              "online",
              "precomputed",
              "validation"
            ],
            "title": "Mode",
            "default": "online"
          },
          "n_cells": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 64.0,
            "title": "N Cells",
            "default": 512
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cell_line",
          "perturbation"
        ],
        "title": "CreateRunRequest"
      },
      "CreateRunResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "status",
          "cache_hit"
        ],
        "title": "CreateRunResponse"
      },
      "DatabaseProvenance": {
        "properties": {
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "title": "Manifest Sha256"
          },
          "files": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Files"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "organism": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organism"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "manifest_sha256",
          "files"
        ],
        "title": "DatabaseProvenance"
      },
      "EvidenceItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subcategory"
          },
          "control": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Control"
          },
          "predicted": {
            "anyOf": [
              {
                "type": "number"
