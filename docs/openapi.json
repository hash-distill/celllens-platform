  "components": {
    "schemas": {
      "ContextItem": {
        "properties": {
          "cell_line": {
            "type": "string",
            "title": "Cell Line"
          },
          "online_ready": {
            "type": "boolean",
            "title": "Online Ready"
          },
          "validation_ready": {
            "type": "boolean",
            "title": "Validation Ready"
          },
          "precomputed_ready": {
            "type": "boolean",
            "title": "Precomputed Ready"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "disabled_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disabled Reason"
          },
          "readiness_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Readiness Reasons"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cell_line",
          "online_ready",
          "validation_ready",
          "precomputed_ready",
          "model_id"
        ],
        "title": "ContextItem"
      },
      "CoverageSummary": {
        "properties": {
          "state_gene_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "State Gene Fraction"
          },
          "metabolic_gene_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Metabolic Gene Fraction"
          },
          "reaction_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Reaction Fraction"
          },
          "supported_tasks": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Supported Tasks"
          },
          "exploratory_tasks": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Exploratory Tasks"
          },
          "insufficient_tasks": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Insufficient Tasks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state_gene_fraction",
          "metabolic_gene_fraction",
          "reaction_fraction",
          "supported_tasks",
          "exploratory_tasks",
          "insufficient_tasks"
        ],
        "title": "CoverageSummary"
      },
      "CreateRunRequest": {
        "properties": {
          "cell_line": {
            "type": "string",
            "enum": [
              "K562",
              "RPE1"
            ],
            "title": "Cell Line"
          },
          "perturbation": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Perturbation"
          },
          "mode": {
            "type": "string",
            "enum": [
              "online",
              "precomputed",
              "validation"
            ],
            "title": "Mode",
            "default": "online"
          },
          "n_cells": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 64.0,
            "title": "N Cells",
            "default": 512
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cell_line",
          "perturbation"
        ],
        "title": "CreateRunRequest"
      },
      "CreateRunResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "status",
          "cache_hit"
        ],
        "title": "CreateRunResponse"
      },
      "EvidenceItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "predicted_delta": {
            "type": "number",
            "title": "Predicted Delta"
          },
          "observed_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed Delta"
          },
          "coverage": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coverage"
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "supported",
              "exploratory",
              "insufficient"
            ],
            "title": "Evidence Level"
          },
          "determinant_genes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Determinant Genes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "predicted_delta",
          "coverage",
          "evidence_level"
        ],
        "title": "EvidenceItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunRecord": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "stage_progress": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Stage Progress"
          },
          "request": {
            "$ref": "#/components/schemas/CreateRunRequest"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "status",
          "stage_progress",
          "request",
          "created_at",
          "updated_at"
        ],
        "title": "RunRecord"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "state_running",
          "adapting",
          "metabolic_running",
          "validating",
          "completed",
          "failed"
        ],
        "title": "RunStatus"
      },
      "RunSummary": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "stage_progress": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Stage Progress"
          },
          "cell_line": {
            "type": "string",
            "title": "Cell Line"
          },
          "perturbation": {
            "type": "string",
            "title": "Perturbation"
          },
          "coverage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CoverageSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "top_genes": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Top Genes"
          },
          "metabolic_tasks": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Metabolic Tasks"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "status",
          "stage_progress",
          "cell_line",
          "perturbation"
        ],
        "title": "RunSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}