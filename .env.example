# Formal operation accepts only saved real model results for replay.
CELLLENS_ALLOW_SYNTHETIC_RESULTS=false
CELLLENS_WORKER_ENABLED=true
CELLLENS_GPU_AVAILABLE=true
CELLLENS_STATE_EXECUTABLE=state
CELLLENS_LOG_LEVEL=INFO
CELLLENS_MAX_PROJECTION_POINTS=12000
CELLLENS_DATABASE_URL=mysql+pymysql://celllens:celllens_dev@127.0.0.1:3307/celllens?charset=utf8mb4
CELLLENS_CREATE_DATABASE_SCHEMA=false
CELLLENS_WORKER_ID=celllens-worker-1
CELLLENS_JOB_LEASE_SECONDS=7200
