# Formal operation accepts only saved real model results for replay.
CELLLENS_ALLOW_SYNTHETIC_RESULTS=false
CELLLENS_WORKER_ENABLED=true
CELLLENS_GPU_AVAILABLE=true
CELLLENS_STATE_EXECUTABLE=state
CELLLENS_LOG_LEVEL=INFO
CELLLENS_MAX_PROJECTION_POINTS=12000
CELLLENS_DATABASE_URL=mysql+pymysql://celllens:celllens_dev@127.0.0.1:3307/celllens?charset=utf8mb4
CELLLENS_CREATE_DATABASE_SCHEMA=false
CELLLENS_WORKER_ID=celllens-worker-1
CELLLENS_JOB_LEASE_SECONDS=7200

# Shared H5AD datasets and CPU analysis (independent of GPU worker).
CELLLENS_DATA_WORKER_ENABLED=true
CELLLENS_MAX_UPLOAD_BYTES=268435456
CELLLENS_MAX_WORKSPACE_STORAGE_BYTES=2147483648
CELLLENS_MAX_DATASET_CELLS=10000
CELLLENS_MAX_DATASET_GENES=60000
CELLLENS_MAX_MATRIX_VALUES=20000000
CELLLENS_MAX_DECODED_BYTES=536870912

# Optional additional exact origins for OpenAI-compatible services. No API keys here.
# Local endpoints must be explicitly allowed by the deployer, e.g. http://127.0.0.1:11434
CELLLENS_ASSISTANT_EXTRA_ORIGINS=
CELLLENS_ASSISTANT_TIMEOUT_SECONDS=90
